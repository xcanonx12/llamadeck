# -------------------------------
# Build configuration
# -------------------------------

# Ubuntu base image version
UBUNTU_VERSION=24.04

# CUDA toolkit version
# This value is a DEFAULT and is overridden automatically by
# docker-build.sh based on your NVIDIA driver
CUDA_VERSION=12.9.0

# Host compiler pinned for the CUDA build (must exist in the base image:
# 24.04 -> 14, 22.04 -> 12). docker-build.sh fills this in if absent.
GCC_VERSION=14


# -------------------------------
# Runtime configuration (optional defaults)
# -------------------------------

# These are not required for the build phase,
# but are useful if you later want to parameterize models.

# MODEL=unsloth/Qwen3-VL-8B-Instruct-GGUF:Q4_K_M
# CTX_SIZE=32768
# PORT=7000
